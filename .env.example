# Public (browser + AI route). Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — never prefix with VITE_
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key          # used by /api/chat (read-only access by design)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # used ONLY by `npm run seed` on your machine; do not add to Vercel
GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-flash-latest
